# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (get it from @userinfobot) — only this user can send links
TELEGRAM_ALLOWED_USER_ID=123456789

# Absolute path to your Obsidian vault folder (or any folder with .md files)
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/Obsidian/MyVault

# Subfolder inside the vault where saved articles go (will be created if missing)
OBSIDIAN_SAVE_FOLDER=Saved

# Optional: default tags to add to every saved note (comma-separated)
DEFAULT_TAGS=saved,reading

# Anthropic API key for AI summary/analysis generation
ANTHROPIC_API_KEY=sk-ant-...

# Path to Marker PDF converter (optional — falls back to pymupdf4llm)
MARKER_PATH=/Users/yourname/.openclaw/tools/marker312/bin/marker_single
